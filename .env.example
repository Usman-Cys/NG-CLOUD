# ==============================================================================
# NGCLOUD ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to ngcloud-backend/.env for local development
# ==============================================================================

# API Gateway Server Configuration
PORT=5000
HTTP_PORT=5001
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# PostgreSQL 15 Configuration (Default docker-compose parameters)
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=dbpassword
DB_NAME=ngcloud

# JSON Web Token Secret (Provide a secure 256-bit random hex string)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_key

# MinIO Object Storage Configuration (Default docker-compose parameters)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=ngcloud-vault

# TLS / HTTPS Configuration (Optional for local testing)
HTTPS_ENABLED=false
SSL_KEY_PATH=ssl/server.key
SSL_CERT_PATH=ssl/server.cert

# Password Hashing Engine (KT-QHF Toroidal Quantum-Walk Simulated Hash)
PASSWORD_HASH_ALGORITHM=ktqhf
KTQHF_PASSWORD_ITERATIONS=10000
KTQHF_PASSWORD_PEPPER=change_this_secret_pepper_for_production

# Bootstrap Initial Administrator
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@ngcloud.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
